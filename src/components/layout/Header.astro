---
import LanguageSwitch from './LanguageSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'
import { pagePath, t, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
}

const { lang, page } = Astro.props
const { nav, a11y } = t(lang)
const home = pagePath(lang, 'home')
---

{/* The running head of the book: whose it is on the left, and on the right
    the three things a reader may want from any page: the index, the CV and
    the other language. */}
<header class="running-head">
  <a href={`${home}#cover`} aria-label={`${nav.brand} — ${nav.home}`}>
    {nav.brand}
  </a>
  <nav class="running-head__nav" aria-label={a11y.mainNav}>
    <a href={`${home}#index`}>{nav.contents}</a>
    <a
      class="running-head__cv"
      href={pagePath(lang, 'cv')}
      target="_blank"
      rel="noopener noreferrer"
    >
      {nav.cv}
      <span class="sr-only">{a11y.external}</span>
    </a>
    <LanguageSwitch lang={lang} page={page} label={a11y.switchLanguage} />
    <ThemeToggle label={a11y.toggleTheme} />
  </nav>
</header>
