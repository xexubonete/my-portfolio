---
import Glyph from '@/components/ui/Glyph.astro'
import LanguageSwitch from './LanguageSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'
import { LINKS, pagePath, t, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
}

const { lang, page } = Astro.props
const { nav, a11y } = t(lang)
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={pagePath(lang, 'home')} aria-label={nav.home}>
      <span class="brand__mark">JB</span>
      <span class="brand__label">{nav.brand}</span>
    </a>
    <nav class="site-nav" aria-label={a11y.mainNav}>
      <a
        class="link-arrow"
        href={LINKS.github}
        target="_blank"
        rel="noreferrer"
      >
        GitHub <Glyph name="arrow" class="arrow" />
        <span class="sr-only">{a11y.external}</span>
      </a>
      <a
        class="link-arrow"
        href={LINKS.linkedin}
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn <Glyph name="arrow" class="arrow" />
        <span class="sr-only">{a11y.external}</span>
      </a>
      <LanguageSwitch lang={lang} page={page} label={a11y.switchLanguage} />
      <ThemeToggle label={a11y.toggleTheme} />
    </nav>
  </div>
</header>
