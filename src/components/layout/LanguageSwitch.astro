---
import { LANGS, pagePath, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
  label: string
}

const { lang, page, label } = Astro.props
const names: Record<Lang, string> = { es: 'Español', en: 'English' }
// English first: `en · es`.
const order = [...LANGS].reverse()
---

{/* Plain links to the same page in the other language: crawlers follow them
    and they work with no script. `data-keep-leaf` lets the book's script add
    the open leaf to the address. The active language is marked, not linked. */}
<span class="lang-switch" aria-label={label}>
  {order.map((item) =>
    item === lang ? (
      <span aria-current="true" lang={item}>
        {item}
      </span>
    ) : (
      <a
        href={pagePath(item, page)}
        hreflang={item}
        lang={item}
        title={names[item]}
        data-keep-leaf
      >
        {item}
      </a>
    ),
  )}
</span>
