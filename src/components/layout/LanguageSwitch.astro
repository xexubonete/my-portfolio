---
import { LANGS, pagePath, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
  label: string
}

const { lang, page, label } = Astro.props
const names: Record<Lang, string> = { es: 'Español', en: 'English' }
---

{/* Plain links to the same page in the other language: no script, and
    crawlers follow them. The active language is marked, not linked. The hall
    script keeps the link pointed at the room the visitor is standing in. */}
<span class="lang-switch" role="group" aria-label={label}>
  {LANGS.map((item) =>
    item === lang ? (
      <span aria-current="true" lang={item}>
        {item}
      </span>
    ) : (
      <a
        href={pagePath(item, page)}
        hreflang={item}
        lang={item}
        title={names[item]}
        data-lang-link
      >
        {item}
      </a>
    ),
  )}
</span>
