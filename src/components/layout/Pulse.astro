---
interface Props {
  /** Tailwind background utility for the dot, e.g. `bg-emerald-500`. */
  color?: string
}

const { color = 'bg-red-400' } = Astro.props
---

<span class="relative flex h-3 w-3">
  <span
    class={`absolute inline-flex h-full w-full animate-ping rounded-full opacity-75 ${color}`}
  ></span>
  <span class={`relative inline-flex h-3 w-3 rounded-full ${color}`}></span>
</span>
