---
import { LINKS, otherLang, pagePath, t, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
}

const { lang, page } = Astro.props
const { footer, a11y } = t(lang)
const other = otherLang(lang)
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="wrap">
    <span>
      © <span data-year>{year}</span> Jesús Bonete
    </span>
    <span>{footer.builtWith}</span>
    <span class="site-footer__links">
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer">
        GitHub <span class="sr-only">{a11y.external}</span>
      </a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn <span class="sr-only">{a11y.external}</span>
      </a>
      <a href={pagePath(other, page)} hreflang={other} lang={other}>
        {other.toUpperCase()}
      </a>
    </span>
  </div>
</footer>

<script is:inline>
  // The build is static: keep the copyright year honest after New Year.
  document.querySelectorAll('[data-year]').forEach(function (el) {
    el.textContent = String(new Date().getFullYear())
  })
</script>
