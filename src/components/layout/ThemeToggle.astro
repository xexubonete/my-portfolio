---
import Glyph from '@/components/ui/Glyph.astro'

interface Props {
  label: string
}

const { label } = Astro.props
---

{/* book.css shows one glyph at a time with the same precedence as the
    tokens: the explicit data-theme first, the OS preference otherwise. By day
    the button is a candle to light; by candlelight, the sun. */}
<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <Glyph name="candle" class="icon-candle" />
  <Glyph name="sun" class="icon-sun" />
</button>

<script is:inline>
  ;(function () {
    var html = document.documentElement
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)')
    var still = window.matchMedia('(prefers-reduced-motion: reduce)')
    document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var set = html.dataset.theme
        var dark = set === 'dark' || (!set && prefersDark.matches)
        var next = dark ? 'light' : 'dark'
        var apply = function () {
          html.dataset.theme = next
          try {
            localStorage.setItem('theme', next)
          } catch (_) {}
        }
        if (!document.startViewTransition || still.matches) return apply()
        // The new light spreads from the button, like a flame catching.
        var box = button.getBoundingClientRect()
        html.style.setProperty('--light-x', box.left + box.width / 2 + 'px')
        html.style.setProperty('--light-y', box.top + box.height / 2 + 'px')
        html.dataset.turn = 'light'
        document.startViewTransition(apply)
      })
    })
  })()
</script>
