---
interface Props {
  /** What the switch does from the light room, and from the dark one. */
  off: string
  on: string
}

const { off, on } = Astro.props
---

{/* The label is whichever of the two the theme in force shows; tokens.css
    decides, with the same precedence as every other token. */}
<button class="lights" type="button" data-theme-toggle>
  <span class="lights__lamp" aria-hidden="true"></span>
  <span class="lights__text in-light">{off}</span>
  <span class="lights__text in-dark">{on}</span>
</button>

<script is:inline>
  ;(function () {
    var html = document.documentElement
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)')
    document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
      button.addEventListener('click', function () {
        var set = html.dataset.theme
        var dark = set === 'dark' || (!set && prefersDark.matches)
        var next = dark ? 'light' : 'dark'
        html.dataset.theme = next
        try {
          localStorage.setItem('theme', next)
        } catch (_) {}
      })
    })
  })()
</script>
