---
import Card from '../Card.astro'
import { badgeVariants } from '@/components/ui/_badge'
import { experienceByLang } from '@/i18n'
import type { Lang } from '@/i18n'

interface Props {
  lang: Lang
  span?: string
}

const { lang, span } = Astro.props

// The card mirrors the most recent role, so company, position and dates stay in
// sync with the experience list (constants.ts / constants-es.ts) automatically.
const [latest] = experienceByLang[lang]
const city = latest.location.split(',')[0]

const strings = {
  es: { title: 'Último trabajo', available: 'Disponible' },
  en: { title: 'Last role', available: 'Available' },
}[lang]
---

<Card span={span}>
  <div class="flex w-full items-center justify-between gap-3">
    <h2 class="z-20 m-0 text-xl font-bold">{strings.title}</h2>
    <span
      class={`${badgeVariants({ variant: 'outline' })} shrink-0 border-emerald-500/45 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400`}
    >
      {strings.available}
    </span>
  </div>
  <div class="mt-4 flex items-center gap-3">
    <img
      src="/cafler-logo.png"
      alt={latest.company}
      width="40"
      height="40"
      class="h-10 w-10 flex-shrink-0 rounded-lg"
    />
    <div class="leading-tight">
      <p class="text-sm font-semibold">{latest.company}</p>
      <p class="text-sm font-light">{latest.position}</p>
      <p class="text-xs text-muted-foreground">
        {latest.start} – {latest.end} · {city}
      </p>
    </div>
  </div>
</Card>
