---
import '@/styles/globals.css'
import '@/styles/cv.css'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import LanguageSwitch from '@/components/layout/LanguageSwitch.astro'
import Glyph from '@/components/ui/Glyph.astro'
import Sprite from '@/components/ui/Sprite.astro'
import { experienceByLang, LINKS, pagePath, t, type Lang } from '@/i18n'
import { formatYears, groupByCompany } from '@/lib/experience'
import { CV_WEBSITE, shortUrl } from '@/lib/cv'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const companyGroups = groupByCompany(experienceByLang[lang])
const { a11y, skills, experience } = t(lang)
const stackLabel = experience.stack

// Printed short ("github.com/xexubonete"), linked in full: an ATS still reads
// the profile, and the PDF keeps a real clickable link.
const profiles = [LINKS.linkedin, LINKS.github, CV_WEBSITE].map((href) => ({
  href,
  label: shortUrl(href),
}))

// Short, CV-specific labels for the same five stack groups the website's
// Stack section renders (src/i18n/content.ts: frameworks, patterns,
// databases, devops, tools, in that order) -- same items, no invented tech.
const techSkillLabels = {
  es: [
    'Lenguajes y frameworks',
    'Arquitectura',
    'Bases de datos',
    'Cloud y DevOps',
    'Testing y herramientas',
  ],
  en: [
    'Languages & Frameworks',
    'Architecture',
    'Databases',
    'Cloud & DevOps',
    'Testing & Tools',
  ],
}[lang]
const techSkillGroups = skills.groups.map((group, i) => ({
  label: techSkillLabels[i],
  items: group.items,
}))

const T = {
  es: {
    role: 'Desarrollador .NET Senior',
    download: 'Descargar PDF',
    back: 'Volver a la web',
    pdf: '/CV_Jesus_Bonete_ES.pdf',
    location: 'Elda, Alicante, España',
    profileTitle: 'Perfil profesional',
    profile:
      'Desarrollador .NET senior con {EXP} de experiencia construyendo servicios robustos y escalables, especializado en arquitecturas limpias, microservicios y optimización de bases de datos. La IA es el núcleo de mi forma de trabajar: integro LLMs y asistentes como Claude o GitHub Copilot en mi día a día para desarrollar más rápido, automatizar tareas y elevar la calidad del código.',
    langTitle: 'Idiomas',
    spanish: 'Español',
    spanishLevel: 'Nativo',
    english: 'Inglés',
    englishLevel: 'B2',
    techSkillsTitle: 'Habilidades técnicas',
    expTitle: 'Experiencia profesional',
    eduTitle: 'Formación',
    eduName: 'Desarrollo de Aplicaciones Web (DAW)',
    eduPlace: 'Alicante, España',
  },
  en: {
    role: 'Senior .NET Developer',
    download: 'Download PDF',
    back: 'Back to site',
    pdf: '/CV_Jesus_Bonete_EN.pdf',
    location: 'Elda, Alicante, Spain',
    profileTitle: 'Summary',
    profile:
      'Senior .NET developer with {EXP} of experience building robust and scalable services, specialized in clean architectures, microservices and database optimization. AI is at the core of how I work: I integrate LLMs and assistants like Claude or GitHub Copilot into my daily workflow to build faster, automate tasks and raise code quality.',
    langTitle: 'Languages',
    spanish: 'Spanish',
    spanishLevel: 'Native',
    english: 'English',
    englishLevel: 'B2',
    techSkillsTitle: 'Technical Skills',
    expTitle: 'Experience',
    eduTitle: 'Education',
    eduName: 'Web Application Development (DAW)',
    eduPlace: 'Alicante, Spain',
  },
}[lang]

// The years figure is rendered at build time and refreshed by the script at
// the bottom, which reads both phrasings from the data attributes.
const expTemplate = {
  es: { plus: 'más de {n} años', exact: '{n} años' },
  en: { plus: '{n}+ years', exact: '{n} years' },
}[lang]
const profileText = T.profile.replace(
  '{EXP}',
  `<b data-exp-plus="${expTemplate.plus}" data-exp-exact="${expTemplate.exact}">${formatYears(expTemplate)}</b>`,
)
---

{/* The sheet is always paper (cv.css), whatever the theme: it prints, it is
    rendered to PDF and it is embedded as a preview. The page around it follows
    the theme like the rest of the site. */}
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV — Jesús Bonete Sánchez</title>
    <link rel="icon" type="image/png" href="/me.png" />
    <ThemeScript />
    <script is:inline>
      // Embedded as the home-page preview: no toolbar, no padding, no shadow.
      if (new URLSearchParams(location.search).get('embed')) {
        document.documentElement.classList.add('is-embed')
      }
    </script>
    <style is:global>
      .is-embed .cv-page {
        padding: 0;
        min-height: 0;
      }
      .is-embed .cv-toolbar {
        display: none;
      }
      .is-embed .cv-sheet {
        box-shadow: none;
      }
    </style>
  </head>
  <body>
    <Sprite />
    <div class="cv-page">
      <div class="cv-toolbar">
        <a
          class="btn btn--accent"
          href={T.pdf}
          download
          target="_blank"
          rel="noopener noreferrer"
        >
          {T.download}
          <Glyph name="arrow" class="arrow" style="width: 1em; height: 1em" />
        </a>
        <LanguageSwitch lang={lang} page="cv" label={a11y.switchLanguage} />
        <a class="btn btn--ghost" href={pagePath(lang, 'home')}>
          {T.back}
        </a>
      </div>

      <article class="cv-sheet">
        {/* Text first, photo second: the portrait is decoration at the top
            right and the header reads the same without it. */}
        <header class="cv-header">
          <div class="cv-heading">
            <h1 class="cv-name">
              Jesús <span>Bonete Sánchez</span>
            </h1>
            <p class="cv-role">{T.role}</p>
            <p class="cv-contact">
              {T.location}
              <span class="sep"> · </span>
              xexubonete@gmail.com
              <span class="sep"> · </span>
              (+34) 722 243 881
            </p>
            <p class="cv-contact cv-contact--links">
              {profiles.map((profile, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a
                    href={profile.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {profile.label}
                  </a>
                </>
              ))}
            </p>
          </div>
          <img class="cv-photo" src="/me.png" alt="Jesús Bonete" />
        </header>

        <main class="cv-main">
          <section class="cv-section">
            <h2>{T.profileTitle}</h2>
            <p class="cv-summary" set:html={profileText} />
          </section>

          <section class="cv-section">
            <h2>{T.techSkillsTitle}</h2>
            {techSkillGroups.map((group) => (
              <p class="cv-tech-group">
                <span class="label">{group.label}:</span>{' '}
                {group.items.join(', ')}
              </p>
            ))}
          </section>

          <section class="cv-section">
            <h2>{T.expTitle}</h2>
            {companyGroups.map((group) =>
              group.roles.length === 1 ? (
                <div class="cv-job">
                  <div class="cv-job-head">
                    <span class="cv-job-period">
                      {group.roles[0].start} – {group.roles[0].end}
                    </span>
                    <span class="cv-job-title">
                      {group.roles[0].position} ·{' '}
                      <a
                        class="cv-job-company"
                        href={group.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {group.company}
                      </a>
                      <span class="cv-job-place">{group.location}</span>
                    </span>
                  </div>
                  <p class="cv-job-summary">{group.roles[0].description}</p>
                  <ul>
                    {group.roles[0].responsibilities.map((task) => (
                      <li>{task}</li>
                    ))}
                  </ul>
                  <p class="cv-stack-line">
                    <span class="label">{stackLabel}</span>{' '}
                    {group.roles[0].stack.join(', ')}
                  </p>
                </div>
              ) : (
                <div class="cv-job">
                  <div class="cv-job-head">
                    <span class="cv-job-period">
                      {group.start} – {group.end}
                    </span>
                    <span class="cv-job-title">
                      <a
                        class="cv-job-company"
                        href={group.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {group.company}
                      </a>
                      <span class="cv-job-place">{group.location}</span>
                    </span>
                  </div>
                  <div class="cv-roles">
                    {group.roles.map((role) => (
                      <div class="cv-role-entry">
                        <div class="cv-job-head">
                          <span class="cv-job-period">
                            {role.start} – {role.end}
                          </span>
                          <span class="cv-job-title">{role.position}</span>
                        </div>
                        <p class="cv-job-summary">{role.description}</p>
                        <ul>
                          {role.responsibilities.map((task) => (
                            <li>{task}</li>
                          ))}
                        </ul>
                        <p class="cv-stack-line">
                          <span class="label">{stackLabel}</span>{' '}
                          {role.stack.join(', ')}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              ),
            )}
          </section>

          <section class="cv-section">
            <h2>{T.eduTitle}</h2>
            <div class="cv-job">
              <div class="cv-job-head">
                <span class="cv-job-period">2020 – 2022</span>
                <span class="cv-job-title">
                  {T.eduName} ·{' '}
                  <span class="cv-job-company">IES Mare Nostrum</span>
                  <span class="cv-job-place">{T.eduPlace}</span>
                </span>
              </div>
            </div>
          </section>

          <section class="cv-section">
            <h2>{T.langTitle}</h2>
            <p class="cv-languages">
              {T.spanish}: {T.spanishLevel} · {T.english}: {T.englishLevel}
            </p>
          </section>
        </main>
      </article>
    </div>

    <script is:inline>
      // The build is static: keep the years-of-experience phrase live (from
      // February 2022). Same contract as the site layout's script.
      ;(function () {
        var now = new Date()
        var month = now.getMonth() + 1
        var years = now.getFullYear() - 2022
        if (month < 2) years -= 1
        var key = month === 2 ? 'expExact' : 'expPlus'
        document.querySelectorAll('[data-exp-plus]').forEach(function (el) {
          el.textContent = el.dataset[key].replace('{n}', years)
        })
      })()
    </script>
  </body>
</html>
