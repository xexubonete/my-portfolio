---
import '@/styles/globals.css'
import '@/styles/cv.css'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import LanguageSwitch from '@/components/layout/LanguageSwitch.astro'
import Glyph from '@/components/ui/Glyph.astro'
import Sprite from '@/components/ui/Sprite.astro'
import { experienceByLang, LINKS, pagePath, t, type Lang } from '@/i18n'
import { formatYears, groupByCompany } from '@/lib/experience'
import { emWidth } from '@/lib/monument'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const companyGroups = groupByCompany(experienceByLang[lang])
const { a11y } = t(lang)

const T = {
  es: {
    role: 'Desarrollador .NET Senior',
    download: 'Descargar PDF',
    back: 'Volver a la web',
    pdf: '/CV_Jesus_Bonete_ES.pdf',
    location: 'Elda, Alicante, España',
    profileTitle: 'Perfil',
    profile:
      'Desarrollador .NET senior con {EXP} de experiencia construyendo servicios robustos y escalables. Especializado en arquitecturas limpias, microservicios y optimización de bases de datos. La IA es el núcleo de mi forma de trabajar: integro LLMs y asistentes como Claude o GitHub Copilot en mi día a día para desarrollar más rápido, automatizar tareas y elevar la calidad del código sin sacrificar buenas prácticas.',
    contactTitle: 'Contacto',
    dataTitle: 'Datos',
    dob: 'Nacimiento',
    nat: 'Nacionalidad',
    natValue: 'Española',
    license: 'Permiso de conducir',
    langTitle: 'Idiomas',
    spanish: 'Español',
    spanishLevel: 'Nativo',
    english: 'Inglés',
    skillsTitle: 'Habilidades',
    expTitle: 'Experiencia',
    eduTitle: 'Formación',
    eduName: 'Desarrollo de Aplicaciones Web (DAW)',
    eduPlace: 'Alicante, España',
    softSkills: [
      'Autoaprendizaje',
      'Trabajo bajo presión',
      'Resolución de problemas',
      'Autonomía y proactividad',
      'Liderazgo',
      'Comunicación',
      'Trabajo en equipo',
      'Adaptabilidad',
    ],
  },
  en: {
    role: 'Senior .NET Developer',
    download: 'Download PDF',
    back: 'Back to site',
    pdf: '/CV_Jesus_Bonete_EN.pdf',
    location: 'Elda, Alicante, Spain',
    profileTitle: 'Profile',
    profile:
      'Senior .NET developer with {EXP} of experience building robust and scalable services. Specialized in clean architectures, microservices and database optimization. AI is at the core of how I work: I integrate LLMs and assistants like Claude or GitHub Copilot into my daily workflow to build faster, automate tasks and raise code quality without compromising best practices.',
    contactTitle: 'Contact',
    dataTitle: 'Details',
    dob: 'Date of birth',
    nat: 'Nationality',
    natValue: 'Spanish',
    license: 'Driving licence',
    langTitle: 'Languages',
    spanish: 'Spanish',
    spanishLevel: 'Native',
    english: 'English',
    skillsTitle: 'Skills',
    expTitle: 'Experience',
    eduTitle: 'Education',
    eduName: 'Web Application Development (DAW)',
    eduPlace: 'Alicante, Spain',
    softSkills: [
      'Self-learning',
      'Working under pressure',
      'Problem solving',
      'Autonomy and proactivity',
      'Leadership',
      'Communication',
      'Teamwork',
      'Adaptability',
    ],
  },
}[lang]

// The years figure is rendered at build time and refreshed by the script at
// the bottom, which reads both phrasings from the data attributes.
const expTemplate = {
  es: { plus: 'más de {n} años', exact: '{n} años' },
  en: { plus: '{n}+ years', exact: '{n} years' },
}[lang]
const NAME = 'Jesús Bonete Sánchez'
const profileText = T.profile.replace(
  '{EXP}',
  `<b data-exp-plus="${expTemplate.plus}" data-exp-exact="${expTemplate.exact}">${formatYears(expTemplate)}</b>`,
)
---

{/* The sheet is always paper (cv.css), whatever the theme: it prints and it
    is rendered to PDF. The page around it follows the theme like the rest of
    the site: the sheet hangs on the wall, or is lit on the screen. */}
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV — Jesús Bonete Sánchez</title>
    <link rel="icon" type="image/png" href="/me.png" />
    <ThemeScript />
  </head>
  <body>
    <Sprite />
    <div class="cv-page">
      <div class="cv-toolbar">
        <a
          class="cv-toolbar__main link"
          href={T.pdf}
          download
          target="_blank"
          rel="noopener noreferrer"
        >
          {T.download}
          <Glyph name="arrow" class="arrow" />
          <span class="sr-only">{a11y.external}</span>
        </a>
        <LanguageSwitch lang={lang} page="cv" label={a11y.switchLanguage} />
        <a class="link" href={pagePath(lang, 'home')}>
          {T.back}
        </a>
      </div>

      <article class="cv-sheet">
        <header class="cv-head">
          {/* The name spans the sheet exactly, sized from its width in em. */}
          <h1 class="cv-name" style={`--em: ${emWidth(NAME).black}`}>
            {NAME}
          </h1>
          <p class="cv-role">
            <span class="dot" aria-hidden="true"></span>
            {T.role}
          </p>
          <p class="cv-place">{T.location}</p>
        </header>

        <aside class="cv-aside">
          <img
            class="cv-photo"
            src="/me.png"
            alt="Jesús Bonete"
            width="96"
            height="96"
          />

          <section>
            <h2>{T.contactTitle}</h2>
            <ul class="cv-list">
              <li>
                <a href={LINKS.mail} target="_blank" rel="noopener noreferrer">
                  xexubonete@gmail.com
                </a>
              </li>
              <li>(+34) 722 243 881</li>
              <li>
                <a
                  href="https://xexubonete.dev"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  xexubonete.dev
                </a>
              </li>
              <li>
                <a
                  href={LINKS.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  linkedin.com/in/jesus-bonete-sanchez
                </a>
              </li>
              <li>
                <a
                  href={LINKS.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  github.com/xexubonete
                </a>
              </li>
            </ul>
          </section>

          <section>
            <h2>{T.dataTitle}</h2>
            <dl class="cv-fields">
              <dt>{T.nat}</dt>
              <dd>{T.natValue}</dd>
              <dt>{T.license}</dt>
              <dd>B</dd>
            </dl>
          </section>

          <section>
            <h2>{T.langTitle}</h2>
            <dl class="cv-fields">
              <dt>{T.spanish}</dt>
              <dd>{T.spanishLevel}</dd>
              <dt>{T.english}</dt>
              <dd>B2</dd>
            </dl>
          </section>

          <section>
            <h2>{T.skillsTitle}</h2>
            <ul class="cv-list">
              {T.softSkills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </section>
        </aside>

        <main class="cv-main">
          <section>
            <h2>{T.profileTitle}</h2>
            <p class="cv-summary" set:html={profileText} />
          </section>

          <section>
            <h2>{T.expTitle}</h2>
            {companyGroups.map((group) =>
              group.roles.length === 1 ? (
                <div class="cv-job">
                  <div class="cv-job-head">
                    <span class="cv-job-title">
                      {group.roles[0].position} ·{' '}
                      <a
                        class="cv-job-company"
                        href={group.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {group.company}
                      </a>
                    </span>
                    <span class="cv-job-period">
                      {group.roles[0].start} – {group.roles[0].end}
                    </span>
                  </div>
                  <div class="cv-job-place">{group.location}</div>
                  <p class="cv-job-summary">{group.roles[0].description}</p>
                  <ul class="cv-tasks">
                    {group.roles[0].responsibilities.map((task) => (
                      <li>{task}</li>
                    ))}
                  </ul>
                  <ul class="cv-stack run">
                    {group.roles[0].stack.map((item) => (
                      <>
                        <li>{item}</li>{' '}
                      </>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="cv-job">
                  <div class="cv-job-head">
                    <a
                      class="cv-job-title cv-job-company"
                      href={group.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {group.company}
                    </a>
                    <span class="cv-job-period">
                      {group.start} – {group.end}
                    </span>
                  </div>
                  <div class="cv-job-place">{group.location}</div>
                  <div class="cv-roles">
                    {group.roles.map((role) => (
                      <div>
                        <div class="cv-job-head">
                          <span class="cv-job-title">{role.position}</span>
                          <span class="cv-job-period">
                            {role.start} – {role.end}
                          </span>
                        </div>
                        <p class="cv-job-summary">{role.description}</p>
                        <ul class="cv-tasks">
                          {role.responsibilities.map((task) => (
                            <li>{task}</li>
                          ))}
                        </ul>
                        <ul class="cv-stack run">
                          {role.stack.map((item) => (
                            <>
                              <li>{item}</li>{' '}
                            </>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              ),
            )}
          </section>

          <section>
            <h2>{T.eduTitle}</h2>
            <div class="cv-job">
              <div class="cv-job-head">
                <span class="cv-job-title">
                  {T.eduName} ·{' '}
                  <span class="cv-job-company">IES Mare Nostrum</span>
                </span>
                <span class="cv-job-period">2020 – 2022</span>
              </div>
              <div class="cv-job-place">{T.eduPlace}</div>
            </div>
          </section>
        </main>
      </article>
    </div>

    <script is:inline>
      // The build is static: keep the years-of-experience phrase live (from
      // February 2022). Same contract as the site layout's script.
      ;(function () {
        var now = new Date()
        var month = now.getMonth() + 1
        var years = now.getFullYear() - 2022
        if (month < 2) years -= 1
        var key = month === 2 ? 'expExact' : 'expPlus'
        document.querySelectorAll('[data-exp-plus]').forEach(function (el) {
          el.textContent = el.dataset[key].replace('{n}', years)
        })
      })()
    </script>
  </body>
</html>
