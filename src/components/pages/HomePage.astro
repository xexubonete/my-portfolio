---
import Contact from '@/components/rooms/Contact.astro'
import Cv from '@/components/rooms/Cv.astro'
import Entrance from '@/components/rooms/Entrance.astro'
import Heading from '@/components/rooms/Heading.astro'
import Portrait from '@/components/rooms/Portrait.astro'
import Projects from '@/components/rooms/Projects.astro'
import Tooling from '@/components/rooms/Tooling.astro'
import Trade from '@/components/rooms/Trade.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t, type Lang } from '@/i18n'
import { roman } from '@/lib/monument'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const content = t(lang)

// The order of the visit. The CV comes second: it is the reason most people
// walk in. The ids are the same in both languages, so a room keeps its
// address when the visitor changes language.
const ORDER = [
  'entrance',
  'cv',
  'trade',
  'tooling',
  'projects',
  'heading',
  'portrait',
  'contact',
] as const
const rooms = ORDER.map((id, i) => ({
  id,
  mark: roman(i + 1),
  title: content[id].title,
}))
const mark = Object.fromEntries(rooms.map((room) => [room.id, room.mark]))
---

<BaseLayout
  lang={lang}
  page="home"
  title={content.meta.title}
  description={content.meta.description}
  rooms={rooms}
>
  <Entrance lang={lang} mark={mark.entrance} next="cv" />
  <Cv lang={lang} mark={mark.cv} />
  <Trade lang={lang} mark={mark.trade} />
  <Tooling lang={lang} mark={mark.tooling} />
  <Projects lang={lang} mark={mark.projects} />
  <Heading lang={lang} mark={mark.heading} />
  <Portrait lang={lang} mark={mark.portrait} />
  <Contact lang={lang} mark={mark.contact} />
</BaseLayout>
