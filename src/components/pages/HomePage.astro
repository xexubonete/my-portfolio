---
import Contact from '@/components/sections/Contact.astro'
import Cv from '@/components/sections/Cv.astro'
import Experience from '@/components/sections/Experience.astro'
import Goals from '@/components/sections/Goals.astro'
import Hero from '@/components/sections/Hero.astro'
import Profile from '@/components/sections/Profile.astro'
import Projects from '@/components/sections/Projects.astro'
import Quote from '@/components/sections/Quote.astro'
import Stack from '@/components/sections/Stack.astro'
import Tape from '@/components/sections/Tape.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { meta } = t(lang)
---

<BaseLayout
  lang={lang}
  page="home"
  title={meta.title}
  description={meta.description}
>
  <main id="main">
    <Hero lang={lang} />
    <Tape lang={lang} />
    <Stack lang={lang} num="01" />
    <Experience lang={lang} num="02" />
    <Projects lang={lang} num="03" />
    <Goals lang={lang} num="04" />
    <Quote lang={lang} />
    <Profile lang={lang} num="06" />
    <Cv lang={lang} num="07" />
    <Contact lang={lang} num="08" />
  </main>
</BaseLayout>
