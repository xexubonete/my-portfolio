---
import Arms from '@/components/book/Arms.astro'
import Author from '@/components/book/Author.astro'
import Campaigns from '@/components/book/Campaigns.astro'
import Contact from '@/components/book/Contact.astro'
import Contents from '@/components/book/Contents.astro'
import Course from '@/components/book/Course.astro'
import Cover from '@/components/book/Cover.astro'
import CvAppendix from '@/components/book/CvAppendix.astro'
import OffDuty from '@/components/book/OffDuty.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { meta } = t(lang)
---

{/* The home is a book. Each component below is one leaf (an open spread), in
    the order of LEAF_IDS; the URL fragment says which one lies open. */}
<BaseLayout
  lang={lang}
  page="home"
  title={meta.title}
  description={meta.description}
>
  {/* The frontispiece is a CSS mask, which the preload scanner cannot see;
      masks are fetched in CORS mode, hence the crossorigin. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/plates/author.png"
    crossorigin="anonymous"
  />
  <main id="main" class="book" data-book>
    <Cover lang={lang} />
    <Contents lang={lang} />
    <Author lang={lang} />
    <Campaigns lang={lang} />
    <Arms lang={lang} />
    <Course lang={lang} />
    <OffDuty lang={lang} />
    <Contact lang={lang} />
    <CvAppendix lang={lang} />
  </main>

  <script is:inline>
    // Scale the embedded A4 CV (794px wide) to the plate that frames it. The
    // observer also fires when the appendix leaf is first laid open.
    ;(function () {
      var sheet = document.querySelector('.facsimile__sheet')
      if (!sheet || !('ResizeObserver' in window)) return
      new ResizeObserver(function () {
        if (!sheet.clientWidth) return
        sheet.style.setProperty('--cv-scale', String(sheet.clientWidth / 794))
      }).observe(sheet)
    })()
  </script>
</BaseLayout>
