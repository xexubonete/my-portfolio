---
import ExpYears from '@/components/ui/ExpYears.astro'
import Glyph from '@/components/ui/Glyph.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { experienceByLang, pagePath, t, type Lang } from '@/i18n'
import { formatYears, groupByCompany } from '@/lib/experience'
import { WORK as WORK_EN } from '@/lib/constants'
import { WORK as WORK_ES } from '@/lib/constants-es'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { experience, nav, a11y } = t(lang)
const description = { es: WORK_ES, en: WORK_EN }[lang].DESCRIPTION
const groups = groupByCompany(experienceByLang[lang])
---

<BaseLayout
  lang={lang}
  page="work"
  title={formatYears(experience.pageTitle)}
  description={description}
>
  <main id="main">
    <div class="wrap">
      <header class="page-title">
        <p class="eyebrow eyebrow--accent">02 — {experience.sectionTitle}</p>
        <h1 class="page-title__h1">
          {experience.pageLead}{' '}
          <span class="accent-word">
            <ExpYears template={experience.years} />
          </span>
        </h1>
        <p>{description}</p>
      </header>

      {groups.map((group, i) => (
        <section class="work-group">
          <div class="work-group__company">
            <span class="section-num">{String(i + 1).padStart(2, '0')}</span>{' '}
            <a
              class="exp__company link-arrow work-group__link"
              href={group.link}
              target="_blank"
              rel="noreferrer"
            >
              {group.company} <Glyph name="arrow" class="arrow" />
              <span class="sr-only">{a11y.external}</span>
            </a>
            <span class="exp__dates">
              {group.start} – {group.end} · {group.location}
            </span>
          </div>
          <div>
            {group.roles.map((role) => (
              <article class="role">
                <div class="exp__dates">
                  {role.start} – {role.end}
                </div>
                <h3 class="role__title">{role.position}</h3>
                <p class="role__summary">{role.description}</p>
                <ul class="role__tasks">
                  {role.responsibilities.map((task) => (
                    <li>{task}</li>
                  ))}
                </ul>
                <div class="role__stack">
                  {role.stack.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <p class="work-back">
        <a class="btn btn--outline" href={pagePath(lang, 'home')}>
          {nav.home}
        </a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .page-title__h1 {
    margin-top: var(--space-3);
  }
  .work-group__link {
    margin-top: var(--space-2);
  }
  .work-back {
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border-strong);
  }
</style>
