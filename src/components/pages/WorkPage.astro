---
import Glyph from '@/components/ui/Glyph.astro'
import Room from '@/components/ui/Room.astro'
import Word from '@/components/ui/Word.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { experienceByLang, t, type Lang } from '@/i18n'
import { formatYears } from '@/lib/experience'
import { WORK as WORK_EN } from '@/lib/constants'
import { WORK as WORK_ES } from '@/lib/constants-es'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { work, a11y } = t(lang)
const description = { es: WORK_ES, en: WORK_EN }[lang].DESCRIPTION

// One room per role, newest first, each under the year it ended: walking the
// hall counts the years back to the first one.
const roles = experienceByLang[lang].map((role) => {
  const year = role.end.slice(-4)
  return { ...role, year, id: `y${year}-${role.start.replace('/', '')}` }
})
const rooms = roles.map((role) => ({
  id: role.id,
  mark: role.year,
  title: `${role.position}, ${role.company}`,
}))
---

<BaseLayout
  lang={lang}
  page="work"
  title={formatYears(work.pageTitle)}
  description={description}
  rooms={rooms}
>
  <h1 slot="page" class="frame__page">
    {work.title}
  </h1>
  {roles.map((role) => (
    <Room
      id={role.id}
      mark={role.year}
      title={role.position}
      line={role.description}
    >
      <Fragment slot="meta">
        <p>
          <a
            class="link"
            href={role.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <strong>{role.company}</strong>
            <Glyph name="arrow" class="arrow" />
            <span class="sr-only">{a11y.external}</span>
          </a>
        </p>
        <p>
          {role.start} – {role.end} · {role.location}
        </p>
      </Fragment>
      <h3 class="body-label">{work.tasks}</h3>
      <ul class="duties">
        {role.responsibilities.map((task) => (
          <li>{task}</li>
        ))}
      </ul>
      <div class="materials materials--one">
        <div>
          <h3 class="body-label">{work.stack}</h3>
          <ul class="run">
            {role.stack.map((item) => (
              <>
                <li>{item}</li>{' '}
              </>
            ))}
          </ul>
        </div>
      </div>
      <Word slot="piece" text={role.year} side="end" />
    </Room>
  ))}
</BaseLayout>
