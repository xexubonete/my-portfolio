---
import Glyph from '@/components/ui/Glyph.astro'
import SectionHead from '@/components/ui/SectionHead.astro'
import { studiesByLang, t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { profile, about, study, languages, softSkills, a11y } = t(lang)
const studies = studiesByLang[lang]
---

<div
  class="col col--profile reveal"
  style="--reveal-delay: 200ms"
  id="profile"
  aria-labelledby="profile-title"
>
  <SectionHead
    num={num}
    title={profile.title}
    meta={profile.meta}
    id="profile-title"
  />
  <div class="profile">
    <div class="profile__about">
      <h3 class="profile__title">{about.title}</h3>
      {about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div>
      <h3 class="profile__title">{study.title}</h3>
      <ul class="chips">
        {studies.map((item) =>
          item.link ? (
            <li>
              <a href={item.link} target="_blank" rel="noopener noreferrer">
                {item.institution}
                {item.date && (
                  <span class="mono">{item.date.replace(' - ', ' – ')}</span>
                )}
                <Glyph name="arrow" class="arrow" />
                <span class="sr-only">{a11y.external}</span>
              </a>
            </li>
          ) : (
            <li>{item.institution}</li>
          ),
        )}
      </ul>
    </div>
    <div>
      <h3 class="profile__title">{languages.title}</h3>
      <ul class="chips">
        {languages.items.map((item) => (
          <li>
            {item.name} <span class="mono">{item.level}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="profile__title">{softSkills.title}</h3>
      <ul class="chips">
        {softSkills.items.map((item) => (
          <li>
            <Glyph name="check" class="check" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
