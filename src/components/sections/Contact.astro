---
import Glyph from '@/components/ui/Glyph.astro'
import SectionHead from '@/components/ui/SectionHead.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { contact } = t(lang)
---

<section
  class="section"
  data-reveal
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="wrap">
    <SectionHead
      num={num}
      title={contact.title}
      meta={contact.meta}
      id="contact-title"
    />
    <div class="contact contact--spaced reveal" style="--reveal-delay: 120ms">
      <address>
        <ul class="contact__links">
          {contact.items.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label} <small>{item.detail}</small>
                <Glyph name="arrow" class="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </address>
      <img
        class="contact__portrait"
        src="/me_chillin.png"
        alt={contact.photoAlt}
        width="420"
        height="420"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .contact--spaced {
    margin-top: var(--space-5);
  }
  address {
    font-style: normal;
  }
</style>
