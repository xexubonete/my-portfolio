---
import Glyph from '@/components/ui/Glyph.astro'
import SectionHead from '@/components/ui/SectionHead.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { contact } = t(lang)
---

<section class="band" data-reveal id="contact" aria-labelledby="contact-title">
  <div class="wrap contact reveal">
    <div class="contact__main">
      <SectionHead
        num={num}
        title={contact.title}
        meta={contact.meta}
        id="contact-title"
      />
      <ul class="contact__links">
        {contact.items.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <span class="contact__label">{item.label}</span>
              <small>{item.detail}</small>
              <Glyph name="arrow" class="arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="contact__aside">
      <img
        class="contact__portrait"
        src="/me_chillin.png"
        alt={contact.photoAlt}
        width="420"
        height="420"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
