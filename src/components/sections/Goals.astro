---
import SectionHead from '@/components/ui/SectionHead.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { goals } = t(lang)
---

<div
  class="col col--goals reveal"
  style="--reveal-delay: 100ms"
  id="goals"
  aria-labelledby="goals-title"
>
  <SectionHead
    num={num}
    title={goals.title}
    meta={goals.meta}
    id="goals-title"
  />
  <p class="goals__intro">{goals.intro}</p>
  <div class="goals">
    {goals.items.map((item, i) => (
      <div class="goal">
        <span class="section-num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="goal__title">{item.label}</h3>
        <p class="goal__text">{item.text}</p>
      </div>
    ))}
  </div>
</div>
