---
import ExpYears from '@/components/ui/ExpYears.astro'
import { experienceByLang, t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { intro, titleBlock, experience } = t(lang)

// The title block mirrors the most recent role, so it follows constants*.ts.
const [latest] = experienceByLang[lang]
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero__top">
      <div class="hero__name-block">
        <p class="eyebrow eyebrow--accent rise">{intro.eyebrow}</p>
        <h1 class="hero__name" id="hero-title">
          <span class="rise" style="--reveal-delay: 80ms">
            {intro.name[0]}
          </span>
          <span class="accent-line rise" style="--reveal-delay: 160ms">
            {intro.name[1]}
          </span>
        </h1>
      </div>
      <div class="hero__portrait rise" style="--reveal-delay: 280ms">
        <img
          src="/me.png"
          alt={intro.photoAlt}
          width="420"
          height="420"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <dl class="title-block rise" style="--reveal-delay: 360ms">
      <div class="title-block__field">
        <dt class="eyebrow">{titleBlock.role}</dt>
        <dd class="title-block__value">{latest.position}</dd>
      </div>
      <div class="title-block__field">
        <dt class="eyebrow">{titleBlock.based}</dt>
        <dd class="title-block__value">{titleBlock.basedValue}</dd>
      </div>
      <div class="title-block__field">
        <dt class="eyebrow">{titleBlock.experience}</dt>
        <dd class="title-block__value">
          <ExpYears template={experience.years} />
        </dd>
      </div>
      <div class="title-block__field">
        <dt class="eyebrow">{titleBlock.status}</dt>
        <dd class="title-block__value">
          <span class="beacon">{titleBlock.available}</span>
        </dd>
      </div>
    </dl>

    <div class="hero__intro rise" style="--reveal-delay: 440ms">
      <p class="lead" set:html={intro.lead} />
      {intro.paragraphs.map((paragraph) => (
        <p class="prose">{paragraph}</p>
      ))}
    </div>
  </div>
</section>
