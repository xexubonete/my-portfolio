---
import SectionHead from '@/components/ui/SectionHead.astro'
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
  num: string
}

const { lang, num } = Astro.props
const { skills } = t(lang)
---

<div
  class="col col--stack reveal"
  style="--reveal-delay: 200ms"
  id="stack"
  aria-labelledby="stack-title"
>
  <SectionHead num={num} title={skills.title} id="stack-title" />
  <div class="stack">
    {skills.groups.map((group, i) => (
      <div class="stack__group">
        <h3 class="stack__label">
          <span class="section-num">
            {num}.{i + 1}
          </span>
          {group.label}
        </h3>
        <ul class="stack__items">
          {group.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
