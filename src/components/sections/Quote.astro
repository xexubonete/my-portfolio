---
import { t, type Lang } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { quote } = t(lang)

// The emphasised words are the tail of the quote; everything before them is
// set in display, the words themselves in the serif italic.
const cut = quote.text.lastIndexOf(quote.accent)
const head = cut === -1 ? quote.text : quote.text.slice(0, cut)
const accent = cut === -1 ? '' : quote.text.slice(cut)
---

<section class="quote-band" data-reveal id="quote">
  <div class="wrap">
    <figure class="reveal">
      <blockquote>
        “{head}
        {accent && <span class="accent-word">{accent}</span>}”
      </blockquote>
      <figcaption>— {quote.author}</figcaption>
    </figure>
  </div>
</section>
