---
/**
 * A landmark section of the home page: an anchor target with a numbered
 * heading, so the header navigation and screen readers can jump to it.
 */
interface Props {
  id: string
  title: string
  /** Section number, printed as a monospace index next to the title. */
  index?: number | undefined
  class?: string
}

const { id, title, index, class: className } = Astro.props
const headingId = `${id}-title`
---

<section
  id={id}
  class:list={['section', className]}
  aria-labelledby={headingId}
>
  <div class="section__inner">
    <header class="section__head">
      {index !== undefined && (
        <span class="section__index" aria-hidden="true">
          {String(index).padStart(2, '0')}
        </span>
      )}
      <h2 id={headingId} class="section__title">
        <slot name="title">{title}</slot>
      </h2>
      <slot name="aside" />
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-10);
    scroll-margin-top: var(--space-8);
  }
  .section__inner {
    max-inline-size: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }
  .section__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }
  .section__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
</style>
