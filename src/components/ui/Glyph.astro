---
/** One of the symbols in <Sprite>. Decorative: the surrounding text labels it. */
interface Props {
  name:
    | 'arrow'
    | 'check'
    | 'sun'
    | 'moon'
    | 'pin'
    | 'mail'
    | 'phone'
    | 'globe'
    | 'linkedin'
    | 'github'
  class?: string
  style?: string
}

const { name, class: className, style } = Astro.props
---

<svg class={className} style={style} aria-hidden="true">
  <use href={`#${name}`}></use>
</svg>
