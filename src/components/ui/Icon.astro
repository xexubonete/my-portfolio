---
/**
 * Inline SVG icons (Lucide outlines plus the GitHub mark), so no icon library
 * ships to the browser. Decorative by default: pass `label` for a meaningful one.
 */
interface Props {
  name: keyof typeof PATHS
  class?: string
  label?: string
  size?: number | string
}

