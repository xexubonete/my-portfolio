---
import HeadSEO from '@/components/layout/HeadSEO.astro'
import LanguageSwitch from '@/components/layout/LanguageSwitch.astro'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import ThemeToggle from '@/components/layout/ThemeToggle.astro'
import Glyph from '@/components/ui/Glyph.astro'
import Sprite from '@/components/ui/Sprite.astro'
import { pagePath, t, type Lang, type PageId } from '@/i18n'

/** A room as the floor index lists it: its anchor, its mark and its name. */
export type RoomMark = { id: string; mark: string; title: string }

interface Props {
  lang: Lang
  page: PageId
  title: string
  description: string
  /** The rooms of the hall, in order. A single room gets no index. */
  rooms: RoomMark[]
  ogImage?: URL | undefined
}

const { lang, page, title, description, rooms, ogImage } = Astro.props
const { a11y, frame } = t(lang)
---

<html lang={lang}>
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      alternates={{ lang, page }}
    />
    <ThemeScript />
  </head>
  <body class="gallery">
    <Sprite />
    <a class="skip-link" href="#main">
      {a11y.skip}
    </a>

    <header class="frame">
      <div class="frame__name">
        <a href={pagePath(lang, 'home')} title={frame.home}>
          Jesús Bonete
        </a>
        <slot name="page" />
      </div>
      <nav class="frame__nav" aria-label={a11y.mainNav}>
        <a
          class="frame__cv link"
          href={pagePath(lang, 'cv')}
          target="_blank"
          rel="noopener noreferrer"
        >
          {frame.cv}
          <Glyph name="arrow" class="arrow" />
          <span class="sr-only">{a11y.external}</span>
        </a>
        <LanguageSwitch lang={lang} page={page} label={a11y.switchLanguage} />
        <ThemeToggle off={frame.lightsOff} on={frame.lightsOn} />
      </nav>
    </header>

    <main id="main" class="hall" data-hall>
      <slot />
    </main>

    <nav class="index" aria-label={a11y.index}>
      {rooms.length > 1 && (
        <>
          <span class="index__dot" aria-hidden="true" />
          <ol class="index__list">
            {rooms.map((room) => (
              <li>
                <a href={`#${room.id}`} data-mark>
                  {room.mark}
                  <span class="index__title">{room.title}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="index__steps" data-steps hidden>
            <button type="button" data-step="-1" aria-label={a11y.previous}>
              <Glyph name="onward" />
            </button>
            <button type="button" data-step="1" aria-label={a11y.next}>
              <Glyph name="onward" />
            </button>
          </div>
        </>
      )}
    </nav>

    <script is:inline>
      ;(function () {
        // The build is static, so the years-of-experience figures are refreshed
        // on the client: every element carries both of its phrasings, and `{n}`
        // is the number of full years since February 2022.
        var now = new Date()
        var month = now.getMonth() + 1
        var years = now.getFullYear() - 2022
        if (month < 2) years -= 1
        var key = month === 2 ? 'expExact' : 'expPlus'
        document.querySelectorAll('[data-exp-plus]').forEach(function (el) {
          el.textContent = el.dataset[key].replace('{n}', years)
        })
        document.querySelectorAll('[data-year]').forEach(function (el) {
          el.textContent = String(now.getFullYear())
        })

        // The hall. Without this script it is still a sideways scroller with
        // snap points, and the index is a list of anchors: everything below
        // is comfort. It turns the wheel and the arrow keys into steps from
        // room to room, marks the room in view on the floor, and keeps the
        // language switch pointed at that same room.
        var hall = document.querySelector('[data-hall]')
        var rooms = [].slice.call(hall.querySelectorAll('[data-room]'))
        if (rooms.length < 2) return
        var marks = [].slice.call(document.querySelectorAll('[data-mark]'))
        var steps = document.querySelector('[data-steps]')
        var buttons = [].slice.call(steps.querySelectorAll('[data-step]'))
        var langLinks = document.querySelectorAll('[data-lang-link]')
        var still = window.matchMedia('(prefers-reduced-motion: reduce)')
        var current = 0

        function mark(i) {
          current = i
          marks.forEach(function (link, n) {
            if (n === i) link.setAttribute('aria-current', 'true')
            else link.removeAttribute('aria-current')
          })
          buttons.forEach(function (button) {
            var to = i + Number(button.dataset.step)
            button.disabled = to < 0 || to >= rooms.length
          })
          langLinks.forEach(function (link) {
            link.hash = i ? rooms[i].id : ''
          })
        }

        function go(i) {
          if (i < 0 || i >= rooms.length) return
          hall.scrollTo({
            left: rooms[i].offsetLeft,
            behavior: still.matches ? 'auto' : 'smooth',
          })
        }

        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) mark(rooms.indexOf(entry.target))
              })
            },
            { root: hall, threshold: 0.6 },
          )
          rooms.forEach(function (room) {
            io.observe(room)
          })
        }
        mark(0)

        steps.hidden = false
        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            go(current + Number(button.dataset.step))
          })
        })

        // A room taller than the screen scrolls itself before giving way.
        function roomCanScroll(down) {
          var room = rooms[current]
          if (room.scrollHeight <= room.clientHeight + 1) return false
          return down
            ? room.scrollTop + room.clientHeight < room.scrollHeight - 1
            : room.scrollTop > 0
        }

        // One step per gesture. A trackpad keeps sending wheel events while
        // its inertia runs out; those arrive close together and fading, so a
        // step needs either a pause before it or a push harder than the last.
        var lastEvent = 0
        var lastStep = 0
        var lastSize = 0
        hall.addEventListener(
          'wheel',
          function (event) {
            if (event.ctrlKey) return
            var size = Math.abs(event.deltaY)
            if (size <= Math.abs(event.deltaX)) return
            if (roomCanScroll(event.deltaY > 0)) return
            event.preventDefault()
            var time = event.timeStamp
            var fresh = time - lastEvent > 160
            var harder = size > lastSize + 2
            lastEvent = time
            lastSize = size
            if (size < 4 || time - lastStep < 520) return
            if (!fresh && !harder && time - lastStep < 1100) return
            lastStep = time
            go(current + (event.deltaY > 0 ? 1 : -1))
          },
          { passive: false },
        )

        var KEYS = {
          ArrowRight: 1,
          ArrowDown: 1,
          PageDown: 1,
          ArrowLeft: -1,
          ArrowUp: -1,
          PageUp: -1,
        }
        document.addEventListener('keydown', function (event) {
          if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey)
            return
          if (event.key === 'Home') go(0)
          else if (event.key === 'End') go(rooms.length - 1)
          else if (KEYS[event.key]) {
            var vertical = /Up|Down/.test(event.key)
            if (vertical && roomCanScroll(KEYS[event.key] > 0)) return
            go(current + KEYS[event.key])
          } else return
          event.preventDefault()
        })
      })()
    </script>
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
</style>
