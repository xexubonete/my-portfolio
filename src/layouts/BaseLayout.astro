---
import Footer from '@/components/layout/Footer.astro'
import HeadSEO from '@/components/layout/HeadSEO.astro'
import Header from '@/components/layout/Header.astro'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import Sprite from '@/components/ui/Sprite.astro'
import { t, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
  title: string
  description: string
  ogImage?: URL | undefined
}

const { lang, page, title, description, ogImage } = Astro.props
const { a11y } = t(lang)
---

<html lang={lang}>
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      alternates={{ lang, page }}
    />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body>
    <Sprite />
    <a class="skip-link" href="#main">
      {a11y.skip}
    </a>
    <Header lang={lang} page={page} />
    <slot />
    <Footer lang={lang} page={page} />

    <script is:inline>
      ;(function () {
        // The build is static, so the years-of-experience figures are refreshed
        // on the client: every element carries both of its phrasings, and `{n}`
        // is the number of full years since February 2022.
        var now = new Date()
        var month = now.getMonth() + 1
        var years = now.getFullYear() - 2022
        if (month < 2) years -= 1
        var key = month === 2 ? 'expExact' : 'expPlus'
        document.querySelectorAll('[data-exp-plus]').forEach(function (el) {
          el.textContent = el.dataset[key].replace('{n}', years)
        })
      })()
    </script>
    <script is:inline>
      // The book. Which leaf lies open is decided by CSS from the URL fragment
      // (see book.css), so all of this is garnish: it plays the page turn, lets
      // the arrow keys turn pages and keeps the language links on the open leaf.
      ;(function () {
        var book = document.querySelector('[data-book]')
        if (!book) return
        var html = document.documentElement
        var leaves = Array.prototype.slice.call(
          book.querySelectorAll('[data-leaf]'),
        )
        var still = window.matchMedia('(prefers-reduced-motion: reduce)')
        var path = function (value) {
          return value.replace(/\/+$/, '')
        }

        function indexOf(hash) {
          var id = decodeURIComponent(hash.slice(1))
          for (var i = 0; i < leaves.length; i++) {
            if (leaves[i].id === id) return i
          }
          return -1
        }

        function current() {
          return Math.max(indexOf(location.hash), 0)
        }

        function keepLeaf() {
          document.querySelectorAll('[data-keep-leaf]').forEach(function (a) {
            a.hash = indexOf(location.hash) > 0 ? location.hash : ''
          })
        }

        function turn(to) {
          var from = current()
          if (to < 0 || to >= leaves.length || to === from) return
          var open = function () {
            location.hash = leaves[to].id
            window.scrollTo(0, 0)
            leaves[to].focus({ preventScroll: true })
          }
          html.dataset.turn = to > from ? 'forward' : 'back'
          if (document.startViewTransition && !still.matches) {
            document.startViewTransition(open)
          } else {
            open()
          }
        }

        document.addEventListener('click', function (event) {
          if (event.defaultPrevented || event.button) return
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
            return
          var link =
            event.target.closest && event.target.closest('a[href*="#"]')
          if (!link || link.target === '_blank') return
          if (link.host !== location.host) return
          if (path(link.pathname) !== path(location.pathname)) return
          var to = indexOf(link.hash)
          if (to < 0) return
          event.preventDefault()
          turn(to)
        })

        document.addEventListener('keydown', function (event) {
          if (event.defaultPrevented) return
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
            return
          if (event.key === 'ArrowRight') turn(current() + 1)
          else if (event.key === 'ArrowLeft') turn(current() - 1)
        })

        window.addEventListener('hashchange', keepLeaf)
        keepLeaf()
      })()
    </script>
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  body {
    display: flex;
    flex-direction: column;
  }
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-sm);
    font-variant-caps: all-small-caps;
    letter-spacing: var(--tracking-caps);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
