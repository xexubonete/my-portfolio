---
import '@/components/ui/primitives.css'
import Footer from '@/components/layout/Footer.astro'
import HeadSEO from '@/components/layout/HeadSEO.astro'
import Header from '@/components/layout/Header.astro'
import ThemeScript from '@/components/layout/ThemeScript.astro'
import { t, type Lang, type PageId } from '@/i18n'

interface Props {
  lang: Lang
  page: PageId
  title: string
  description: string
  ogImage?: URL | undefined
}

const { lang, page, title, description, ogImage } = Astro.props
const { a11y } = t(lang)
---

<html lang={lang}>
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      alternates={{ lang, page }}
    />
    <ThemeScript />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {a11y.skip}
    </a>
    <Header lang={lang} page={page} />
    <slot />
    <Footer lang={lang} />

    <script is:inline>
      // The build is static, so the years-of-experience figures are refreshed on
      // the client: every element carries both of its phrasings, and `{n}` is the
      // number of full years since February 2022.
      ;(function () {
        var now = new Date()
        var month = now.getMonth() + 1
        var years = now.getFullYear() - 2022
        if (month < 2) years -= 1
        var key = month === 2 ? 'expExact' : 'expPlus'
        document.querySelectorAll('[data-exp-plus]').forEach(function (el) {
          el.textContent = el.dataset[key].replace('{n}', years)
        })
      })()
    </script>
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
  body {
    min-block-size: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  main {
    flex: 1;
  }
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-s);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    ::before,
    ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
