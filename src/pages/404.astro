---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'

// There is one 404 for every URL, so it speaks the site's default language.
const lang = 'en'
const { notFound } = t(lang)
---

<BaseLayout
  lang={lang}
  page="home"
  title="404 - Not Found"
  description="404 Error — this page was not found"
>
  <main id="main" class="hero not-found">
    <div class="wrap not-found__grid">
      <div>
        <p class="eyebrow eyebrow--accent">{notFound.eyebrow}</p>
        <p class="display-hero display not-found__code">{notFound.code}</p>
        <h1 class="not-found__title">{notFound.title}</h1>
        <p class="not-found__body">{notFound.body}</p>
        <p class="not-found__action">
          <a class="btn" href="/">
            {notFound.back}
          </a>
        </p>
      </div>
      <img
        class="not-found__portrait"
        src="/me_chillin.png"
        alt=""
        width="420"
        height="420"
      />
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100dvh - 3.5rem);
    display: grid;
    align-items: center;
  }
  .not-found__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
  .not-found__code {
    color: var(--color-accent-vivid);
    margin-top: var(--space-3);
  }
  .not-found__title {
    font-size: var(--text-3xl);
    margin-top: var(--space-5);
  }
  .not-found__body {
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    max-width: 40ch;
  }
  .not-found__action {
    margin-top: var(--space-6);
  }
  .not-found__portrait {
    width: clamp(10rem, 12rem + 10vw, 22rem);
  }
  @media (max-width: 47.99rem) {
    .not-found__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .not-found__portrait {
      justify-self: center;
    }
  }
</style>
