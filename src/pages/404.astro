---
import Icon from '@/components/ui/Icon.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'

// There is one 404 for every URL, so it speaks the site's default language.
const lang = 'en'
const { notFound } = t(lang)
---

<BaseLayout
  lang={lang}
  page="home"
  title="404 - Not Found"
  description="404 Error — this page was not found"
>
  <main id="main" class="not-found">
    <img
      src="/me_chillin.png"
      width="420"
      height="420"
      alt=""
      class="not-found__photo"
    />
    <p class="not-found__code">{notFound.code}</p>
    <h1 class="not-found__title">{notFound.title}</h1>
    <p class="not-found__body">{notFound.body}</p>
    <a class="button button--primary" href="/">
      <Icon name="arrow-left" size={18} />
      {notFound.back}
    </a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-3);
    min-block-size: 70vh;
    padding: var(--space-10) var(--space-5);
    text-align: center;
  }
  .not-found__photo {
    inline-size: min(100%, 14rem);
    block-size: auto;
    margin-block-end: var(--space-4);
  }
  .not-found__code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }
  .not-found__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .not-found__body {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
  }
</style>
