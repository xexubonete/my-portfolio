---
import Glyph from '@/components/ui/Glyph.astro'
import Room from '@/components/ui/Room.astro'
import Word from '@/components/ui/Word.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'

// There is one 404 for every URL, so it speaks the site's default language.
const lang = 'en'
const { notFound } = t(lang)
---

<BaseLayout
  lang={lang}
  page="home"
  title="404 - Not Found"
  description="404 Error — this page was not found"
  rooms={[{ id: 'nowhere', mark: notFound.code, title: notFound.title }]}
>
  <Room id="nowhere" mark="—" title={notFound.title} line={notFound.line}>
    <h1 slot="title" id="nowhere-title">
      {notFound.title}
    </h1>
    <p class="acts">
      <a class="link" href="/">
        {notFound.back}
        <Glyph name="onward" class="arrow" />
      </a>
    </p>
    <Word slot="piece" text={notFound.code} />
  </Room>
</BaseLayout>
