---
import Leaf from '@/components/book/Leaf.astro'
import Plate from '@/components/book/Plate.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'

// There is one 404 for every URL, so it speaks the site's default language.
const lang = 'en'
const { notFound } = t(lang)
---

<BaseLayout
  lang={lang}
  page="home"
  title="404 - Not Found"
  description="404 Error — this page was not found"
>
  <main id="main" class="book">
    <Leaf
      id="torn"
      index={0}
      label={notFound.title}
      full="both"
      versoClass="page--tailpiece"
    >
      <Plate
        slot="verso"
        src="/plates/tailpiece.png"
        alt={notFound.photoAlt}
        ratio="1"
      />
      <div slot="recto" class="torn">
        <p class="opener__word">{notFound.word}</p>
        <p class="torn__code">{notFound.code}</p>
        <h1 class="torn__title">{notFound.title}</h1>
        <p class="torn__body">{notFound.body}</p>
        <p class="torn__action">
          <a class="cartouche cartouche--rubric" href="/">
            {notFound.back}
          </a>
        </p>
      </div>
    </Leaf>
  </main>
</BaseLayout>
